{
  "version": 2,
  "outputDirectory": ".",
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/videos/(.*)",
      "dest": "/public/videos/$1"
    },
    {
      "src": "/vpn",
      "dest": "/api/vpn"
    },
    {
      "src": "/",
      "dest": "/api/index"
    },
    {
      "src": "/api/?$",
      "dest": "/api/index"
    }
  ]
}
