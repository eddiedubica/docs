{
  "version": 2,
  "functions": {
    "middleware.ts": {
      "runtime": "@vercel/edge"
    }
  },
  "routes": [
    {
      "src": "/((?!_vercel|favicon|apple-touch).*)",
      "middlewarePath": "middleware",
      "continue": true
    },
    {
      "src": "/videos/(.*)",
      "dest": "/public/videos/$1"
    },
    {
      "src": "/shadowrocket.conf",
      "dest": "/api/shadowrocket-conf"
    },
    {
      "src": "/vpn",
      "dest": "/api/vpn"
    },
    {
      "src": "/",
      "dest": "/api/index"
    },
    {
      "src": "/api/?$",
      "dest": "/api/index"
    }
  ]
}
