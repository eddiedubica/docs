{
  "version": 2,
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/videos/(.*)",
      "dest": "/public/videos/$1"
    },
    {
      "src": "/vpn",
      "dest": "/api/vpn"
    },
    {
      "src": "/",
      "dest": "/api/index"
    },
    {
      "src": "/api/?$",
      "dest": "/api/index"
    }
  ]
}
